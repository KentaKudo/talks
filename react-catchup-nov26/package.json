{
  "name": "react-catchup-nov26",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run demo:build && vite --host 127.0.0.1 --port 3000",
    "demo:build": "vite build --config demo/vite.config.ts",
    "build": "npm run demo:build && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node e2e/smoke.mjs",
    "build:pages": "npm run demo:build && vite build --mode pages",
    "build:inspect": "npm run demo:build && vite build --mode inspect",
    "dev:react": "npm run demo:build && vite --mode inspect --host 127.0.0.1 --port 3000",
    "compare:builds": "node scripts/compare-builds.mjs"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/redact": "^0.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.25",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "oxc-transform-react": "^0.156.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
